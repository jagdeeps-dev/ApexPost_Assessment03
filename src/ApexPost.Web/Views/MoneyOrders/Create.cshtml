@model MoneyOrderViewModel
@{ ViewData["Title"] = "Issue money order"; }
<div class="page-heading"><div><p class="eyebrow">FINANCIAL SERVICES</p><h1>Issue a money order</h1><p class="muted">High-value orders require successful identity verification.</p></div></div>
<section class="panel form-panel narrow-panel"><form asp-action="Create" method="post"><input asp-for="TransactionId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="Sender">Sender</label><input asp-for="Sender" autocomplete="off" /><span asp-validation-for="Sender" class="validation"></span></div><div><label asp-for="Recipient">Recipient</label><input asp-for="Recipient" autocomplete="off" /><span asp-validation-for="Recipient" class="validation"></span></div><div><label asp-for="Amount">Amount (₹)</label><input asp-for="Amount" type="number" min="1" step="0.01" /><span asp-validation-for="Amount" class="validation"></span></div>@if (Model.TransactionId is null) { <div><label asp-for="PaymentMethod">Payment method</label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select></div> } else { <div class="span-two"><p class="fine-print">The money order will be added to transaction @Model.TransactionId. Take payment from the transaction screen when the basket is complete.</p></div> }<div><label asp-for="BranchCode">Branch</label><input asp-for="BranchCode" readonly /></div><div class="span-two"><label asp-for="IdentityVerificationId">Successful identity-verification record ID (required above ₹1,000)</label><input asp-for="IdentityVerificationId" autocomplete="off" maxlength="32" /><span class="fine-print">Record verification separately from the transaction details screen. The money-order form cannot mark identity as verified by itself.</span></div></div><button class="button button-primary" type="submit">@(Model.TransactionId is null ? "Issue money order and take payment" : "Add money order to basket")</button></form></section>
