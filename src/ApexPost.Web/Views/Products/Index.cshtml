@model IReadOnlyList<ProductStockReadDto>
@{ ViewData["Title"] = "Catalogue & stock"; }
<div class="page-heading"><div><p class="eyebrow">RETAIL OPERATIONS</p><h1>Catalogue & stock</h1><p class="muted">Product pricing, tax category and available quantity in your branch.</p></div></div>
@if (User.IsInRole("Administrator")) { <section class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><h2>Set-based category price revision</h2><form asp-action="RevisePrices" method="post" class="form-row"><div><label for="Category">Category</label><select id="Category" name="Category" asp-items="Html.GetEnumSelectList<ApexPost.Domain.ProductCategory>()"></select></div><div><label for="Multiplier">Multiplier (e.g. 1.05 = +5%)</label><input id="Multiplier" name="Multiplier" type="number" min="0.01" max="5" step="0.01" value="1.05" required /></div><button class="button button-primary" type="submit">Apply revision</button></form></section> }
<section class="panel table-panel"><div class="table-toolbar"><h2>Product catalogue</h2><span class="pill">@Model.Count products</span></div><div class="table-scroll"><table><thead><tr><th>SKU</th><th>Product</th><th>Category</th><th>Tax</th><th class="numeric">Unit price</th><th class="numeric">Available</th></tr></thead><tbody>
@foreach (var product in Model) { <tr><td><code>@product.Sku</code></td><td class="primary-cell">@product.Name</td><td>@product.Category</td><td>@product.TaxCategory</td><td class="numeric">₹@product.UnitPrice.ToString("N2")</td><td class="numeric"><span class="stock @(product.Quantity <= (int)ViewBag.LowStockThreshold ? "stock-low" : "")">@product.Quantity</span></td></tr> }
</tbody></table></div></section>
